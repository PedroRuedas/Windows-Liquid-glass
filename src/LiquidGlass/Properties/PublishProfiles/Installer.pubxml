<?xml version="1.0" encoding="utf-8"?>
<!--
    Publicação usada pelo instalador: autocontida (não exige o .NET instalado) e pré-compilada
    (ReadyToRun), para iniciar rápido e não gastar CPU nem memória compilando código ao abrir.
-->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishReadyToRun>true</PublishReadyToRun>
        <PublishSingleFile>false</PublishSingleFile>
        <DebugType>none</DebugType>
        <PublishDir>..\..\artifacts\publish\</PublishDir>
        <BuildInstaller>true</BuildInstaller>
    </PropertyGroup>
    <ItemGroup>
        <!--
            A projeção das APIs do Windows (WinRT) só é usada pela prévia de mídia; pré-compilada,
            ela passaria de 50 MB. Sem ReadyToRun, carrega só quando a prévia aparece.
        -->
        <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    </ItemGroup>
</Project>
