<Popup x:Class="LiquidGlass.Views.WindowPreview"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:controls="clr-namespace:LiquidGlass.Controls"
        xmlns:res="clr-namespace:LiquidGlass.Resources"
       AllowsTransparency="True"
       Placement="Custom"
       PopupAnimation="None"
       StaysOpen="True">

    <Popup.Resources>
        <SolidColorBrush x:Key="CardHoverFill" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="CardActiveBorder" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="ThumbnailPlaceholder" Color="#14FFFFFF" />

        <!--
            Lado a lado com a dock embaixo; empilhadas com ela nas laterais. Com muitas janelas, o
            limite do painel (MaxWidth ou MaxHeight, definido no código) as quebra em mais linhas.
        -->
        <ItemsPanelTemplate x:Key="HorizontalCards">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="VerticalCards">
            <WrapPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Width="22" Height="22" Background="Transparent" CornerRadius="11">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9"
                                       Text="&#xE8BB;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão redondo de mídia: o glifo vem no Content; o de tocar vira pausar enquanto toca. -->
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Width="30" Height="30" Background="Transparent" CornerRadius="15">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Popup.Resources>

    <!-- O espaçamento é a área da sombra; dentro dele fica o único elemento animado. -->
    <Border Padding="14">
        <Grid x:Name="PopupContent">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>

            <controls:LiquidGlassSurface Style="{StaticResource PopupGlassSurface}" CornerRadius="22" />

            <StackPanel Margin="8"
                        TextElement.Foreground="White"
                        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
                <!-- O que o app está tocando (Spotify, um vídeo no navegador), com os controles. -->
                <Border x:Name="MediaCard"
                        Width="300"
                        Margin="2,2,2,6"
                        Padding="8"
                        HorizontalAlignment="Left"
                        Background="#14FFFFFF"
                        CornerRadius="14"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Border DockPanel.Dock="Left"
                                Width="56"
                                Height="56"
                                Background="#1FFFFFFF"
                                CornerRadius="8">
                            <Border.Clip>
                                <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,56,56" />
                            </Border.Clip>
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20"
                                           Opacity="0.6"
                                           Text="&#xE8D6;" />
                                <Image Source="{Binding Artwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,2,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Opacity="0.75" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Margin="-6,4,0,0" Orientation="Horizontal">
                                <Button Style="{StaticResource MediaButton}" Click="OnMediaPrevious" IsEnabled="{Binding CanPrevious}" ToolTip="{x:Static res:Strings.MediaPrevious}" Content="&#xE892;" />
                                <Button x:Name="PlayPause" Style="{StaticResource MediaButton}" Click="OnMediaPlayPause" ToolTip="{x:Static res:Strings.MediaPlayPause}" Content="&#xE768;" />
                                <Button Style="{StaticResource MediaButton}" Click="OnMediaNext" IsEnabled="{Binding CanNext}" ToolTip="{x:Static res:Strings.MediaNext}" Content="&#xE893;" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ItemsControl x:Name="Cards">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Margin="2"
                                    Padding="8,6,8,8"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    MouseLeftButtonDown="OnCardLeftButtonDown"
                                    MouseLeftButtonUp="OnCardLeftButtonUp"
                                    MouseUp="OnCardMouseUp">
                                <StackPanel Width="{Binding ThumbnailWidth}">
                                    <DockPanel Height="22" Margin="2,0,0,6">
                                        <Button x:Name="Close"
                                                DockPanel.Dock="Right"
                                                Margin="6,0,0,0"
                                                Style="{StaticResource CloseButton}"
                                                ToolTip="{x:Static res:Strings.CloseWindow}"
                                                Visibility="Hidden"
                                                Click="OnCloseClick" />
                                        <Image Width="16"
                                               Height="16"
                                               Margin="0,0,7,0"
                                               Source="{Binding Icon, Mode=OneTime}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <!-- O DWM desenha a miniatura viva da janela exatamente por cima deste retângulo. -->
                                    <Border x:Name="Thumbnail"
                                            Width="{Binding ThumbnailWidth}"
                                            Height="{Binding ThumbnailHeight}"
                                            Background="{StaticResource ThumbnailPlaceholder}"
                                            CornerRadius="6"
                                            Loaded="OnThumbnailLoaded" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource CardActiveBorder}" />
                                </DataTrigger>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{StaticResource CardHoverFill}" />
                                    <Setter TargetName="Close" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Só com mais janelas do que cabem na tela: o menu do botão direito lista todas. -->
                <TextBlock x:Name="MoreWindows"
                           Margin="10,4,10,2"
                           FontSize="12"
                           Opacity="0.75"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Border>
</Popup>
