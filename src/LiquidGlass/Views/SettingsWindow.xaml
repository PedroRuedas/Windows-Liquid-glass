<Window x:Class="LiquidGlass.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LiquidGlass.Controls"
        xmlns:converters="clr-namespace:LiquidGlass.Converters"
        xmlns:models="clr-namespace:LiquidGlass.Models"
        xmlns:viewModels="clr-namespace:LiquidGlass.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
        Title="Personalizar a Dock"
        Width="940"
        Height="680"
        MinWidth="780"
        MinHeight="520"
        Language="pt-BR"
        ThemeMode="System"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LiquidGlass;component/Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:IndexToVisibilityConverter x:Key="IndexToVisibility" />
            <converters:ColorToBrushConverter x:Key="ColorToBrush" />
            <converters:ColorsEqualConverter x:Key="ColorsEqual" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegação -->
        <DockPanel Margin="12,16,8,12">
            <StackPanel DockPanel.Dock="Top" Margin="12,0,0,20" Orientation="Horizontal">
                <Image Width="32" Height="32" Source="{StaticResource StartIcon}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Liquid Glass" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding Version, StringFormat=Versão {0}}" />
                </StackPanel>
            </StackPanel>

            <Button DockPanel.Dock="Bottom"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ResetDefaultsCommand}"
                    Content="Restaurar padrões" />

            <ListBox x:Name="Navigation" SelectedIndex="0" BorderThickness="0" Background="Transparent">
                <ListBox.Resources>
                    <Style TargetType="TextBlock" x:Key="NavGlyph">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="Margin" Value="0,0,14,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </ListBox.Resources>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE771;" />
                        <TextBlock Text="Aparência" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE790;" />
                        <TextBlock Text="Vidro" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE945;" />
                        <TextBlock Text="Animações" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                        <TextBlock Text="Comportamento" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE718;" />
                        <TextBlock Text="Apps fixados" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="1" Margin="8,16,0,0">

            <!-- Aparência -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Aparência" />

                    <controls:SettingCard Glyph="&#xE7C4;" Header="Posição na tela" Description="Borda onde a dock fica ancorada.">
                        <ComboBox Width="180" SelectedValue="{Binding Settings.Edge}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Embaixo" Tag="{x:Static models:DockEdge.Bottom}" />
                            <ComboBoxItem Content="À esquerda" Tag="{x:Static models:DockEdge.Left}" />
                            <ComboBoxItem Content="À direita" Tag="{x:Static models:DockEdge.Right}" />
                        </ComboBox>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE91B;" Header="Tamanho dos ícones">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="32" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.IconSize}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.IconSize, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE8A9;" Header="Espaçamento entre ícones">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.IconSpacing}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.IconSpacing, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE799;" Header="Comprimento da dock" Description="Estende o vidro ao longo da tela. Em 0% ele só envolve os ícones.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.DockLength}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.DockLength, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE73F;" Header="Distância da borda" Description="Espaço entre a dock e a borda da tela.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.EdgeMargin}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.EdgeMargin, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE91F;" Header="Arredondamento" Description="De cantos retos até o formato de pílula.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Roundness}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Roundness, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Elementos" />

                    <controls:SettingCard Glyph="&#xE8EC;" Header="Nome do app ao passar o mouse">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowLabels}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE915;" Header="Indicador de app aberto" Description="Ponto abaixo dos apps em execução.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowRunningIndicators}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE782;" Header="Botão Iniciar">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowStartButton}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7C4;" Header="Botão das áreas de trabalho" Description="Abre o cubo das áreas de trabalho, como no Fedora.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowWorkspacesButton}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE70E;" Header="Apps em segundo plano" Description="Botão que mostra os ícones da bandeja do sistema.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowTray}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE701;" Header="Rede" Description="Wi-Fi com a força do sinal, ou rede cabeada. O clique abre a lista de redes.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowNetwork}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE83F;" Header="Bateria" Description="Carga e tempo restante. Só aparece em computadores com bateria.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowBattery}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE74D;" Header="Lixeira no final da dock">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowRecycleBin}" />
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Vidro -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Vidro" />

                    <controls:SettingCard Glyph="&#xE8F1;" Header="Estilos prontos">
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="6,0,0,0"
                                            MinWidth="86"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Óptica" />

                    <controls:SettingCard Glyph="&#xE81E;" Header="Refração" Description="Quanto a borda curva distorce o que está atrás.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Refraction}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Refraction, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xEB42;" Header="Desfoque" Description="Deixa o fundo mais fosco.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Blur}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Blur, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xF157;" Header="Dispersão de cores" Description="Franja de arco-íris nas bordas, como em um prisma.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.ChromaticAberration}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.ChromaticAberration, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE706;" Header="Brilho da borda" Description="Reflexo de luz no contorno do vidro.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Highlight}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Highlight, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7B3;" Header="Saturação" Description="Intensidade das cores vistas através do vidro.">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="2" Value="{Binding Settings.Saturation}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Saturation, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE793;" Header="Sombra">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Shadow}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Shadow, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Cor" />

                    <controls:SettingCard Glyph="&#xE790;" Header="Tom do vidro">
                        <ItemsControl x:Name="Swatches" ItemsSource="{Binding TintSwatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SwatchButton}"
                                            Background="{Binding Converter={StaticResource ColorToBrush}}"
                                            Command="{Binding DataContext.SetTintCommand, ElementName=Swatches}"
                                            CommandParameter="{Binding}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource ColorsEqual}">
                                                <Binding />
                                                <Binding Path="DataContext.Settings.TintColor" ElementName="Swatches" />
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE9E9;" Header="Intensidade do tom">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="0.8" Value="{Binding Settings.TintStrength}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.TintStrength, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Animações -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Animações" />

                    <controls:SettingCard Glyph="&#xE8A3;" Header="Ampliação" Description="Os ícones crescem quando o mouse passa por cima.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.MagnificationEnabled}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE740;" Header="Tamanho máximo" IsEnabled="{Binding Settings.MagnificationEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="1.1" Maximum="3" Value="{Binding Settings.Magnification}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Magnification, StringFormat={}{0:0.0}×}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xF0E2;" Header="Alcance" Description="Quantos ícones vizinhos também crescem." IsEnabled="{Binding Settings.MagnificationEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="1" Maximum="6" Value="{Binding Settings.MagnificationRange}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.MagnificationRange, StringFormat={}{0:0.0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="Movimento" />

                    <controls:SettingCard Glyph="&#xE768;" Header="Quicar ao abrir um app">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.BounceOnLaunch}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xEA8F;" Header="Quicar quando um app pede atenção" Description="Por exemplo, uma mensagem nova em segundo plano.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.BounceOnAttention}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE73F;" Header="Fechar e minimizar no estilo do GNOME" Description="A janela encolhe ao fechar e voa até o ícone dela na dock ao minimizar.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AnimateWindows}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE8AB;" Header="Cubo ao trocar de área de trabalho" Description="Ctrl+Win+setas giram o cubo das áreas de trabalho, como no Fedora.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AnimateWorkspaceSwitch}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xEC4A;" Header="Velocidade das animações">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0.5" Maximum="2" Value="{Binding Settings.AnimationSpeed}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.AnimationSpeed, StringFormat={}{0:0.0}×}" />
                        </StackPanel>
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Comportamento -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Comportamento" />

                    <controls:SettingCard Glyph="&#xE890;" Header="Ocultar a dock automaticamente" Description="A dock aparece quando o mouse encosta na borda.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoHide}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE75B;" Header="Barra de tarefas do Windows" Description="Ela volta ao normal sempre que a dock é fechada.">
                        <ComboBox Width="200" SelectedValue="{Binding Settings.TaskbarMode}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Oculta" Tag="{x:Static models:TaskbarMode.Hidden}" />
                            <ComboBoxItem Content="Ocultar automaticamente" Tag="{x:Static models:TaskbarMode.AutoHide}" />
                            <ComboBoxItem Content="Visível" Tag="{x:Static models:TaskbarMode.Visible}" />
                        </ComboBox>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7E8;" Header="Iniciar com o Windows">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.LaunchAtStartup}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7C4;" Header="Win+Tab abre o cubo das áreas de trabalho" Description="Usa o cubo da dock no lugar da Visão de Tarefas do Windows.">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.WinTabOpensOverview}" />
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Apps fixados -->
            <DockPanel Margin="16,0,28,28" Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Apps fixados" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,-8,0,14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Dica: arraste atalhos ou programas para a dock para fixá-los."
                           TextWrapping="Wrap" />

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Orientation="Horizontal">
                    <Button Command="{Binding AddAppCommand}" Content="Adicionar app…" />
                    <Button Margin="8,0,0,0" Command="{Binding ImportTaskbarPinsCommand}" Content="Importar da barra de tarefas" />
                    <Button Margin="24,0,0,0" Command="{Binding MovePinUpCommand}" ToolTip="Mover para cima">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70E;" />
                    </Button>
                    <Button Margin="4,0,0,0" Command="{Binding MovePinDownCommand}" ToolTip="Mover para baixo">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;" />
                    </Button>
                    <Button Margin="4,0,0,0" Command="{Binding RemovePinCommand}" ToolTip="Remover da dock">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" />
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Pins}"
                         SelectedItem="{Binding SelectedPin}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4" Orientation="Horizontal">
                                <Image Width="28" Height="28" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Pin.Name}" />
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Pin.Target}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
