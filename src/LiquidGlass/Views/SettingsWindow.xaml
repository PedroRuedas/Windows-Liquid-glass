<Window x:Class="LiquidGlass.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LiquidGlass.Controls"
        xmlns:converters="clr-namespace:LiquidGlass.Converters"
        xmlns:models="clr-namespace:LiquidGlass.Models"
        xmlns:viewModels="clr-namespace:LiquidGlass.ViewModels"
        xmlns:res="clr-namespace:LiquidGlass.Resources"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:SettingsViewModel}"
        Title="{x:Static res:Strings.SettingsTitle}"
        Width="940"
        Height="680"
        MinWidth="780"
        MinHeight="520"
        Language="pt-BR"
        ThemeMode="System"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LiquidGlass;component/Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:IndexToVisibilityConverter x:Key="IndexToVisibility" />
            <converters:ColorToBrushConverter x:Key="ColorToBrush" />
            <converters:ColorsEqualConverter x:Key="ColorsEqual" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegação -->
        <DockPanel Margin="12,16,8,12">
            <StackPanel DockPanel.Dock="Top" Margin="12,0,0,20" Orientation="Horizontal">
                <Image Width="32" Height="32" Source="{StaticResource StartIcon}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Liquid Glass" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding VersionText}" />
                </StackPanel>
            </StackPanel>

            <Button DockPanel.Dock="Bottom"
                    HorizontalAlignment="Stretch"
                    Command="{Binding ResetDefaultsCommand}"
                    Content="{x:Static res:Strings.RestoreDefaults}" />

            <ListBox x:Name="Navigation" SelectedIndex="0" BorderThickness="0" Background="Transparent">
                <ListBox.Resources>
                    <Style TargetType="TextBlock" x:Key="NavGlyph">
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="Margin" Value="0,0,14,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </ListBox.Resources>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE771;" />
                        <TextBlock Text="{x:Static res:Strings.PageAppearance}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE790;" />
                        <TextBlock Text="{x:Static res:Strings.PageGlass}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE945;" />
                        <TextBlock Text="{x:Static res:Strings.PageAnimations}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                        <TextBlock Text="{x:Static res:Strings.PageBehavior}" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE718;" />
                        <TextBlock Text="{x:Static res:Strings.PagePinnedApps}" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <Grid Grid.Column="1" Margin="8,16,0,0">

            <!-- Aparência -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.PageAppearance}" />

                    <controls:SettingCard Glyph="&#xE7C4;" Header="{x:Static res:Strings.Position}" Description="{x:Static res:Strings.PositionDescription}">
                        <ComboBox Width="180" SelectedValue="{Binding Settings.Edge}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{x:Static res:Strings.EdgeBottom}" Tag="{x:Static models:DockEdge.Bottom}" />
                            <ComboBoxItem Content="{x:Static res:Strings.EdgeLeft}" Tag="{x:Static models:DockEdge.Left}" />
                            <ComboBoxItem Content="{x:Static res:Strings.EdgeRight}" Tag="{x:Static models:DockEdge.Right}" />
                        </ComboBox>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE91B;" Header="{x:Static res:Strings.IconSize}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="16" Maximum="96" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.IconSize}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.IconSize, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE8A9;" Header="{x:Static res:Strings.IconSpacing}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.IconSpacing}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.IconSpacing, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE799;" Header="{x:Static res:Strings.DockLength}" Description="{x:Static res:Strings.DockLengthDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.DockLength}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.DockLength, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE73F;" Header="{x:Static res:Strings.EdgeMargin}" Description="{x:Static res:Strings.EdgeMarginDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.EdgeMargin}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.EdgeMargin, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE91F;" Header="{x:Static res:Strings.Roundness}" Description="{x:Static res:Strings.RoundnessDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Roundness}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Roundness, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SectionElements}" />

                    <controls:SettingCard Glyph="&#xE8EC;" Header="{x:Static res:Strings.ShowLabels}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowLabels}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE915;" Header="{x:Static res:Strings.RunningIndicator}" Description="{x:Static res:Strings.RunningIndicatorDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowRunningIndicators}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE8A9;" Header="{x:Static res:Strings.WindowPreviews}" Description="{x:Static res:Strings.WindowPreviewsDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowWindowPreviews}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE782;" Header="{x:Static res:Strings.StartButton}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowStartButton}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7C4;" Header="{x:Static res:Strings.DesktopsButton}" Description="{x:Static res:Strings.DesktopsButtonDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowWorkspacesButton}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE70E;" Header="{x:Static res:Strings.BackgroundApps}" Description="{x:Static res:Strings.BackgroundAppsDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowTray}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE701;" Header="{x:Static res:Strings.Network}" Description="{x:Static res:Strings.NetworkDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowNetwork}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE83F;" Header="{x:Static res:Strings.Battery}" Description="{x:Static res:Strings.BatteryDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowBattery}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE74D;" Header="{x:Static res:Strings.RecycleBinAtEnd}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.ShowRecycleBin}" />
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Vidro -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.PageGlass}" />

                    <controls:SettingCard Glyph="&#xE8F1;" Header="{x:Static res:Strings.Presets}">
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="6,0,0,0"
                                            MinWidth="86"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SectionOptics}" />

                    <controls:SettingCard Glyph="&#xE81E;" Header="{x:Static res:Strings.Refraction}" Description="{x:Static res:Strings.RefractionDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Refraction}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Refraction, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xEB42;" Header="{x:Static res:Strings.Blur}" Description="{x:Static res:Strings.BlurDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Blur}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Blur, StringFormat={}{0:0} px}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xF157;" Header="{x:Static res:Strings.ChromaticAberration}" Description="{x:Static res:Strings.ChromaticAberrationDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.ChromaticAberration}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.ChromaticAberration, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE706;" Header="{x:Static res:Strings.Highlight}" Description="{x:Static res:Strings.HighlightDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Highlight}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Highlight, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7B3;" Header="{x:Static res:Strings.Saturation}" Description="{x:Static res:Strings.SaturationDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="2" Value="{Binding Settings.Saturation}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Saturation, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE793;" Header="{x:Static res:Strings.Shadow}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Settings.Shadow}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Shadow, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SectionColor}" />

                    <controls:SettingCard Glyph="&#xE790;" Header="{x:Static res:Strings.Tint}">
                        <ItemsControl x:Name="Swatches" ItemsSource="{Binding TintSwatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SwatchButton}"
                                            Background="{Binding Converter={StaticResource ColorToBrush}}"
                                            Command="{Binding DataContext.SetTintCommand, ElementName=Swatches}"
                                            CommandParameter="{Binding}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource ColorsEqual}">
                                                <Binding />
                                                <Binding Path="DataContext.Settings.TintColor" ElementName="Swatches" />
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE9E9;" Header="{x:Static res:Strings.TintStrength}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0" Maximum="0.8" Value="{Binding Settings.TintStrength}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.TintStrength, StringFormat={}{0:P0}}" />
                        </StackPanel>
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Animações -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.PageAnimations}" />

                    <controls:SettingCard Glyph="&#xE8A3;" Header="{x:Static res:Strings.Magnification}" Description="{x:Static res:Strings.MagnificationDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.MagnificationEnabled}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE740;" Header="{x:Static res:Strings.MaximumSize}" IsEnabled="{Binding Settings.MagnificationEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="1.1" Maximum="3" Value="{Binding Settings.Magnification}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.Magnification, StringFormat={}{0:0.0}×}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xF0E2;" Header="{x:Static res:Strings.MagnificationRange}" Description="{x:Static res:Strings.MagnificationRangeDescription}" IsEnabled="{Binding Settings.MagnificationEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="1" Maximum="6" Value="{Binding Settings.MagnificationRange}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.MagnificationRange, StringFormat={}{0:0.0}}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SectionMotion}" />

                    <controls:SettingCard Glyph="&#xE768;" Header="{x:Static res:Strings.BounceOnLaunch}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.BounceOnLaunch}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xEA8F;" Header="{x:Static res:Strings.BounceOnAttention}" Description="{x:Static res:Strings.BounceOnAttentionDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.BounceOnAttention}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE73F;" Header="{x:Static res:Strings.AnimateWindows}" Description="{x:Static res:Strings.AnimateWindowsDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AnimateWindows}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE8AB;" Header="{x:Static res:Strings.AnimateDesktopSwitch}" Description="{x:Static res:Strings.AnimateDesktopSwitchDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AnimateWorkspaceSwitch}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xEC4A;" Header="{x:Static res:Strings.AnimationSpeed}">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="220" IsMoveToPointEnabled="True" Minimum="0.5" Maximum="2" Value="{Binding Settings.AnimationSpeed}" />
                            <TextBlock Style="{StaticResource ValueText}" Text="{Binding Settings.AnimationSpeed, StringFormat={}{0:0.0}×}" />
                        </StackPanel>
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Comportamento -->
            <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                <StackPanel Margin="16,0,28,28">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.PageBehavior}" />

                    <controls:SettingCard Glyph="&#xE890;" Header="{x:Static res:Strings.AutoHide}" Description="{x:Static res:Strings.AutoHideDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.AutoHide}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE75B;" Header="{x:Static res:Strings.WindowsTaskbar}" Description="{x:Static res:Strings.WindowsTaskbarDescription}">
                        <ComboBox Width="200" SelectedValue="{Binding Settings.TaskbarMode}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="{x:Static res:Strings.TaskbarHidden}" Tag="{x:Static models:TaskbarMode.Hidden}" />
                            <ComboBoxItem Content="{x:Static res:Strings.TaskbarAutoHide}" Tag="{x:Static models:TaskbarMode.AutoHide}" />
                            <ComboBoxItem Content="{x:Static res:Strings.TaskbarVisible}" Tag="{x:Static models:TaskbarMode.Visible}" />
                        </ComboBox>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7E8;" Header="{x:Static res:Strings.LaunchAtStartup}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.LaunchAtStartup}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE782;" Header="{x:Static res:Strings.GlassStartMenu}" Description="{x:Static res:Strings.GlassStartMenuDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.UseGlassStartMenu}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE7C4;" Header="{x:Static res:Strings.WinTabOpensCube}" Description="{x:Static res:Strings.WinTabOpensCubeDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.WinTabOpensOverview}" />
                    </controls:SettingCard>

                    <!-- O idioma vale ao abrir a dock: depois de trocar, a descrição avisa e aparece o botão de reiniciar. -->
                    <controls:SettingCard Glyph="&#xE774;" Header="{x:Static res:Strings.Language}" Description="{Binding LanguageDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,12,0"
                                    Command="{Binding RestartCommand}"
                                    Content="{x:Static res:Strings.RestartDock}"
                                    Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox Width="200"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding Languages}"
                                      SelectedValue="{Binding Settings.Language}"
                                      SelectedValuePath="Value" />
                        </StackPanel>
                    </controls:SettingCard>

                    <TextBlock x:Name="UpdatesSection" Style="{StaticResource SectionTitle}" Text="{x:Static res:Strings.SectionUpdates}" />

                    <controls:SettingCard Glyph="&#xE895;" Header="Liquid Glass Dock" Description="{Binding UpdateStatus}">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar Width="120"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center"
                                         Maximum="1"
                                         Value="{Binding Updates.Progress, Mode=OneWay}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding UpdateActionCommand}" Content="{Binding UpdateActionText}" />
                        </StackPanel>
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE823;" Header="{x:Static res:Strings.CheckForUpdatesAutomatically}" Description="{x:Static res:Strings.CheckForUpdatesAutomaticallyDescription}">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Settings.CheckForUpdates}" />
                    </controls:SettingCard>

                    <controls:SettingCard Glyph="&#xE9D9;" Header="{x:Static res:Strings.Diagnostics}" Description="{Binding DiagnosticsDescription}">
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,12,0" Command="{Binding ReportProblemCommand}" Content="{x:Static res:Strings.ReportProblem}" />
                            <Button Command="{Binding CopyDiagnosticsCommand}" Content="{x:Static res:Strings.Copy}" />
                        </StackPanel>
                    </controls:SettingCard>
                </StackPanel>
            </ScrollViewer>

            <!-- Apps fixados -->
            <DockPanel Margin="16,0,28,28" Visibility="{Binding SelectedIndex, ElementName=Navigation, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{x:Static res:Strings.PagePinnedApps}" />
                <TextBlock DockPanel.Dock="Top"
                           Margin="0,-8,0,14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{x:Static res:Strings.PinnedAppsTip}"
                           TextWrapping="Wrap" />

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Orientation="Horizontal">
                    <Button Command="{Binding AddAppCommand}" Content="{x:Static res:Strings.AddApp}" />
                    <Button Margin="8,0,0,0" Command="{Binding ImportTaskbarPinsCommand}" Content="{x:Static res:Strings.ImportFromTaskbar}" />
                    <Button Margin="24,0,0,0" Command="{Binding MovePinUpCommand}" ToolTip="{x:Static res:Strings.MoveUp}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70E;" />
                    </Button>
                    <Button Margin="4,0,0,0" Command="{Binding MovePinDownCommand}" ToolTip="{x:Static res:Strings.MoveDown}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE70D;" />
                    </Button>
                    <Button Margin="4,0,0,0" Command="{Binding RemovePinCommand}" ToolTip="{x:Static res:Strings.RemoveFromDockTooltip}">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE74D;" />
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Pins}"
                         SelectedItem="{Binding SelectedPin}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4" Orientation="Horizontal">
                                <Image Width="28" Height="28" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Pin.Name}" />
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Pin.Target}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
