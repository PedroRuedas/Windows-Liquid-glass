<Window x:Class="LiquidGlass.Views.StartMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LiquidGlass.Controls"
        Title="Iniciar"
        Width="668"
        Height="694"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextElement.Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="TileHover" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="TileSelected" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SearchFill" Color="#1AFFFFFF" />
        <LinearGradientBrush x:Key="SearchBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#40FFFFFF" />
            <GradientStop Offset="1" Color="#14FFFFFF" />
        </LinearGradientBrush>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="10,0,0,8" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource PopupSecondaryText}" />
            <Setter Property="Margin" Value="10,4,10,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Rolagem sem barra visível: a roda do mouse e o toque continuam rolando. -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="PanningMode" Value="VerticalOnly" />
        </Style>

        <!-- App fixado: ícone com o nome embaixo, em até duas linhas. -->
        <DataTemplate x:Key="PinTile">
            <Border x:Name="Tile"
                    Width="96"
                    Height="86"
                    Background="Transparent"
                    CornerRadius="10"
                    ToolTip="{Binding Name}"
                    MouseLeftButtonUp="OnEntryClick"
                    MouseRightButtonUp="OnEntryMenu">
                <StackPanel Margin="4,12,4,0">
                    <Image Width="32"
                           Height="32"
                           Source="{Binding Icon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="0,7,0,0"
                               MaxHeight="32"
                               FontSize="12"
                               LineHeight="16"
                               Text="{Binding Name}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource TileHover}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Linha com ícone, nome e uma segunda linha (quando, onde ou o tipo do item). -->
        <DataTemplate x:Key="EntryRow">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="28"
                       Height="28"
                       Source="{Binding Icon}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource PopupSecondaryText}"
                               Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <!-- Sem segunda linha (apps), o nome fica no meio da linha. -->
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RecentRow">
            <Border x:Name="Row"
                    Margin="0,0,6,4"
                    Padding="10,5"
                    Background="Transparent"
                    CornerRadius="10"
                    ToolTip="{Binding Target}"
                    MouseLeftButtonUp="OnEntryClick"
                    MouseRightButtonUp="OnEntryMenu">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource EntryRow}" />
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource TileHover}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="White" />
            <EventSetter Event="MouseLeftButtonUp" Handler="OnEntryClick" />
            <EventSetter Event="MouseRightButtonUp" Handler="OnEntryMenu" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Margin="0,0,0,2"
                                Padding="10,5"
                                Background="Transparent"
                                CornerRadius="10">
                            <ContentPresenter ContentTemplate="{StaticResource EntryRow}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource TileHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource TileSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A margem é a área da sombra; dentro dela fica o único elemento animado. -->
    <Border Padding="14">
        <Grid x:Name="PopupContent">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>

            <controls:LiquidGlassSurface x:Name="Glass"
                                         Style="{StaticResource PopupGlassSurface}"
                                         CornerRadius="28"
                                         BezelWidth="26" />

            <Grid Margin="28,26,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Height="40"
                        Background="{StaticResource SearchFill}"
                        BorderBrush="{StaticResource SearchBorder}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <Grid>
                        <TextBlock Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource PopupSecondaryText}"
                                   Text="&#xE721;" />
                        <TextBlock x:Name="SearchHint"
                                   Margin="46,0,16,1"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource PopupSecondaryText}"
                                   IsHitTestVisible="False"
                                   Text="Pesquisar aplicativos, configurações e documentos" />
                        <TextBox x:Name="SearchBox"
                                 Margin="42,0,16,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="White"
                                 FontSize="14"
                                 Foreground="White"
                                 SelectionBrush="#80FFFFFF"
                                 TextChanged="OnSearchChanged" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,22,0,0">
                    <StackPanel x:Name="HomePanel">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Fixado" />
                        <ScrollViewer Height="258">
                            <StackPanel>
                                <ItemsControl x:Name="Pins" HorizontalAlignment="Center" ItemTemplate="{StaticResource PinTile}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Width="576" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock x:Name="PinsEmpty"
                                           Style="{StaticResource Hint}"
                                           Text="Pesquise um app e escolha &quot;Fixar no Iniciar&quot; no botão direito para ele aparecer aqui."
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Margin="10,18,0,8" Style="{StaticResource SectionTitle}" Text="Recente" />
                        <ItemsControl x:Name="Recent" ItemTemplate="{StaticResource RecentRow}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock x:Name="RecentEmpty"
                                   Style="{StaticResource Hint}"
                                   Text="Os arquivos que você abrir aparecem aqui."
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <Grid x:Name="ResultsPanel" Visibility="Collapsed">
                        <ListBox x:Name="Results"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 ItemContainerStyle="{StaticResource ResultItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="10,10,0,6" Style="{StaticResource SectionTitle}" Text="{Binding Name}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                        <TextBlock x:Name="NoResults"
                                   Margin="10,10,10,0"
                                   Style="{StaticResource Hint}"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>

                <!-- Rodapé: a conta à esquerda e o botão de energia (bloquear, sair, desligar...) à direita. -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Border Height="1" VerticalAlignment="Top" Background="{StaticResource PopupSeparator}" />
                    <Grid Margin="0,12,0,0">
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{StaticResource TileHover}"
                                    CornerRadius="14">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           Text="&#xE77B;" />
                            </Border>
                            <TextBlock x:Name="UserName"
                                       Margin="12,0,0,1"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border x:Name="PowerButton"
                                Width="38"
                                Height="38"
                                HorizontalAlignment="Right"
                                CornerRadius="10"
                                ToolTip="Energia"
                                MouseLeftButtonUp="OnPowerClick">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TileHover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       Text="&#xE7E8;" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
