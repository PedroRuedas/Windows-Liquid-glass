<Popup x:Class="LiquidGlass.Views.TrayFlyout"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       AllowsTransparency="True"
       Placement="Custom"
       PopupAnimation="Fade"
       StaysOpen="False">

    <Border Margin="14"
            Padding="10,8,10,10"
            Background="{StaticResource MenuBackground}"
            BorderBrush="{StaticResource MenuBorder}"
            BorderThickness="1"
            CornerRadius="12"
            TextElement.Foreground="White"
            TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.45" ShadowDepth="4" />
        </Border.Effect>

        <StackPanel>
            <TextBlock Margin="4,0,4,8"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Opacity="0.7"
                       Text="Apps em segundo plano" />

            <TextBlock x:Name="EmptyText"
                       Margin="4,4,4,6"
                       FontSize="13"
                       Opacity="0.6"
                       Text="Nenhum app na bandeja agora."
                       Visibility="Collapsed" />

            <ItemsControl x:Name="Icons" MaxWidth="264">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Cell"
                                Width="44"
                                Height="44"
                                Background="Transparent"
                                CornerRadius="8"
                                ToolTip="{Binding Title}"
                                MouseEnter="OnIconMouseEnter"
                                MouseLeave="OnIconMouseLeave"
                                MouseMove="OnIconMouseMove"
                                MouseDown="OnIconMouseDown"
                                MouseUp="OnIconMouseUp">
                            <Image Width="24"
                                   Height="24"
                                   Source="{Binding Icon}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Popup>
