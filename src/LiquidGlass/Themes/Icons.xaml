<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Os ícones não têm fundo próprio. O retângulo transparente fixa a área do desenho em
        6,6,88,88 (a mesma dos ícones de app): sem ele, o Image esticaria o logotipo ou a seta até
        as bordas do ícone.
    -->

    <!-- Botão Iniciar: logotipo do Windows 11 colorido. -->
    <DrawingImage x:Key="StartIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,6,88,88" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#FF6BD3FF" />
                            <GradientStop Offset="0.5" Color="#FF1A9BF0" />
                            <GradientStop Offset="1" Color="#FF0A5FD0" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="12,12,36,36" RadiusX="3" RadiusY="3" />
                            <RectangleGeometry Rect="52,12,36,36" RadiusX="3" RadiusY="3" />
                            <RectangleGeometry Rect="12,52,36,36" RadiusX="3" RadiusY="3" />
                            <RectangleGeometry Rect="52,52,36,36" RadiusX="3" RadiusY="3" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Áreas de trabalho: três janelas lado a lado, como a visão geral do GNOME. -->
    <DrawingImage x:Key="WorkspacesIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,6,88,88" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#59FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="10,36,16,28" RadiusX="5" RadiusY="5" />
                            <RectangleGeometry Rect="74,36,16,28" RadiusX="5" RadiusY="5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F2FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="30,28,40,44" RadiusX="7" RadiusY="7" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Bandeja do sistema: seta para cima, como o "mostrar ícones ocultos". -->
    <DrawingImage x:Key="TrayIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="6,6,88,88" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 31,58 L 50,39 L 69,58">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>
